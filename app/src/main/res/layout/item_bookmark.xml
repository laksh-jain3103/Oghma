<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@color/surface"
    android:orientation="horizontal">

    <!-- Highlight colour -->
    <View
        android:id="@+id/bookmarkColorBar"
        android:layout_width="6dp"
        android:layout_height="match_parent"
        android:background="#FFD60A" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="4dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/bookmarkBookTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Book title"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/bookmarkEditButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Edit note"
                android:padding="11dp"
                android:src="@android:drawable/ic_menu_edit"
                app:tint="@color/text_secondary" />

        </LinearLayout>

        <TextView
            android:id="@+id/bookmarkChapter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chapter"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/bookmarkText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingEnd="10dp"
            android:text="Selected text"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <!-- The reader's own note (hidden when empty) -->
        <TextView
            android:id="@+id/bookmarkNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@color/surface_variant"
            android:padding="10dp"
            android:text="Note"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>

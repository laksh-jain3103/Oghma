<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true">

    <!-- ===================================================== -->
    <!-- Header -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/readerHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/background_deep"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="12dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@color/text_secondary" />

        <TextView
            android:id="@+id/readerTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="Oghma"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Read aloud. Visible for EPUB and PDF, hidden for TXT (see ReaderFragment.displayBook). -->
        <TextView
            android:id="@+id/ttsButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_listen_pill"
            android:clickable="true"
            android:contentDescription="Read aloud"
            android:drawablePadding="6dp"
            android:drawableStart="@drawable/ic_listen"
            android:drawableTint="@color/background_deep"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="96dp"
            android:paddingStart="14dp"
            android:paddingEnd="16dp"
            android:text="Listen"
            android:textColor="@color/background_deep"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- Reader container -->
    <!-- ===================================================== -->

    <com.reader.oghma.reader.PinchZoomLayout
        android:id="@+id/readerContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/background"
        app:layout_constraintBottom_toTopOf="@id/ttsBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/readerHeader">

        <TextView
            android:id="@+id/readerText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/background"
            android:gravity="top|start"
            android:padding="20dp"
            android:scrollbars="vertical"
            android:text="Loading..."
            android:textColor="@color/text_primary"
            android:textIsSelectable="true"
            android:textSize="17sp" />

    </com.reader.oghma.reader.PinchZoomLayout>

    <!-- ===================================================== -->
    <!-- Read-aloud controls (only visible while reading aloud) -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/ttsBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/background_deep"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/progressFooter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageButton
            android:id="@+id/ttsPrevious"
            android:layout_width="48dp"
            android:layout_height="52dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Previous sentence"
            android:padding="14dp"
            android:src="@android:drawable/ic_media_previous"
            app:tint="@color/text_primary" />

        <ImageButton
            android:id="@+id/ttsPlayPause"
            android:layout_width="56dp"
            android:layout_height="52dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Play or pause"
            android:padding="12dp"
            android:src="@android:drawable/ic_media_pause"
            app:tint="@color/text_primary" />

        <ImageButton
            android:id="@+id/ttsNext"
            android:layout_width="48dp"
            android:layout_height="52dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Next sentence"
            android:padding="14dp"
            android:src="@android:drawable/ic_media_next"
            app:tint="@color/text_primary" />

        <TextView
            android:id="@+id/ttsSpeed"
            android:layout_width="56dp"
            android:layout_height="52dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Reading speed"
            android:gravity="center"
            android:text="1.0x"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ttsVoice"
            android:layout_width="64dp"
            android:layout_height="52dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Choose voice"
            android:gravity="center"
            android:text="Voice"
            android:textColor="@color/accent_blue"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/ttsStop"
            android:layout_width="48dp"
            android:layout_height="52dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Stop reading"
            android:padding="14dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/text_secondary" />

    </LinearLayout>

    <!-- ===================================================== -->
    <!-- Book progress: follows reading, and the voice when    -->
    <!-- reading aloud. Drag it to jump to another place.      -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/progressFooter"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/background_deep"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:paddingBottom="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/progressLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text=""
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/progressPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="0%"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <SeekBar
            android:id="@+id/progressSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="1000"
            android:paddingStart="6dp"
            android:paddingTop="6dp"
            android:paddingEnd="6dp"
            android:paddingBottom="6dp"
            android:progressBackgroundTint="@color/surface_high"
            android:progressTint="@color/primary"
            android:thumbTint="@color/primary" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>